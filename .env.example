# =============================================================================
# HubFlow — environment variables
# Copy this file to `.env` (or `.env.local`) and fill in values from the
# Supabase dashboard.
# =============================================================================

# ---- Database ----------------------------------------------------------------
# Use the SESSION-MODE pooler (port 5432) OR the direct connection URI.
# Do NOT use the transaction pooler on port 6543 — PostgresSaver and other
# consumers rely on prepared statements, which that pooler does not support.
# Find it in: Supabase → Project Settings → Database → Connection string
#   • Session pooler:  postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   • Direct:          postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL= 

# ---- App secrets -------------------------------------------------------------
# Strong random string, >= 32 chars. AES-256-GCM key for encrypting credential
# tokens at rest. Generate with e.g. `openssl rand -base64 48`.
ENCRYPTION_KEY=

# ---- SMTP (nodemailer) -------------------------------------------------------
# Outbound email transport used by the `send_email` tool. Gmail/Outlook/SES/
# Mailtrap/Postmark all work — anything with SMTP credentials.
#
# Common presets:
#   • Gmail (App Password required):  host=smtp.gmail.com    port=587  secure=false
#   • Outlook 365:                     host=smtp.office365.com port=587  secure=false
#   • Mailtrap sandbox (safe testing): host=sandbox.smtp.mailtrap.io  port=587  secure=false
#   • Direct TLS (rare):               host=<provider>        port=465  secure=true
SMTP_HOST=
SMTP_PORT=587
# `true` for port 465 (implicit TLS), `false` for 587/25 (STARTTLS upgrade).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Default From address. Format: "Display Name <address@domain.com>".
# Falls back to SMTP_USER when unset.
SMTP_FROM=
