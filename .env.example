# =============================================================================
# HubFlow — environment variables
# Copy this file to `.env` (or `.env.local`) and fill in values from the
# Supabase dashboard.
# =============================================================================

# ---- Database ----------------------------------------------------------------
# Use the SESSION-MODE pooler (port 5432) OR the direct connection URI.
# Do NOT use the transaction pooler on port 6543 — PostgresSaver and other
# consumers rely on prepared statements, which that pooler does not support.
# Find it in: Supabase → Project Settings → Database → Connection string
#   • Session pooler:  postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   • Direct:          postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL= 

# ---- App secrets -------------------------------------------------------------
# Strong random string, >= 32 chars. AES-256-GCM key for encrypting credential
# tokens at rest. Generate with e.g. `openssl rand -base64 48`.
ENCRYPTION_KEY=
